# ---------------------------------------------------------------------------
# Reference environment configuration.
#
#   cp .env.example .env
#
# Every value below is the default that docker-compose.yml already applies, so
# an empty .env works. Uncomment only what you are actually changing.
# ---------------------------------------------------------------------------

# --- Versions --------------------------------------------------------------
# Pinned deliberately. Verified present on their registries 2026-08-17.
LOCALAI_VERSION=v4.8.2
LOCALRECALL_VERSION=v0.6.4

# NOT v2.9.0. quay.io/mudler/localagi:v2.9.0 does not exist — the image build
# has been failing since 2026-04-15 while the sshbox image of the same version
# published successfully. v2.8.1 is the highest available tag.
LOCALAGI_VERSION=v2.8.1

# --- Models ----------------------------------------------------------------
# Both are used by every recipe in the handbook. Reasons for these choices are
# in docs/00-overview/version-matrix.md.
#
# qwen3-1.7b        1.19 GiB Q4_K_M, 32k context, apache-2.0. Its gallery entry
#                   is wired for native tool calling, which is what makes the
#                   agent recipes work on a small model.
# granite-embedding 211 MiB F16, 384 dimensions, apache-2.0. Upstream's own
#                   default in three independent places.
LLM_MODEL=qwen3-1.7b
EMBEDDING_MODEL=granite-embedding-107m-multilingual

# Step up if answer quality is insufficient. Identical configuration.
# LLM_MODEL=qwen3-4b

# --- Ports (host side) -----------------------------------------------------
LOCALAI_PORT=8080
LOCALAGI_PORT=8081
LOCALRECALL_PORT=8082

# --- Topology --------------------------------------------------------------
# LocalAI ships its own agent pool. In this separated environment we run a
# standalone LocalAGI instead, so the built-in pool is disabled to avoid two
# runtimes competing for one state directory. Set to false only if you want to
# compare the two side by side.
LOCALAI_DISABLE_AGENTS=true

# --- Vector storage --------------------------------------------------------
# postgres  vector + BM25 hybrid search, concurrent readers, real backup.
# chromem   single file, no hybrid search, one process only.
# localai   stores vectors via LocalAI's /stores API. Several methods are
#           unimplemented — do not choose it for new work.
VECTOR_ENGINE=postgres

POSTGRES_DB=localrecall
POSTGRES_USER=localrecall
# Change this for anything reachable beyond your workstation.
POSTGRES_PASSWORD=localrecall

# --- Chunking --------------------------------------------------------------
# Characters, not tokens. Upstream defaults are 400 and 0; we set an overlap of
# 80 (20%) because zero overlap cuts sentences at chunk boundaries and loses the
# thought that spanned them.
#
# Changing these affects only documents ingested AFTERWARDS. Existing chunks are
# not re-split.
MAX_CHUNKING_SIZE=400
CHUNK_OVERLAP=80

# --- Hybrid search (postgres engine only) ----------------------------------
# Relative weight of dense vector similarity against BM25 lexical scoring.
# Raise the BM25 weight when queries contain exact identifiers — error codes,
# function names, SKUs — which embeddings match poorly.
HYBRID_SEARCH_VECTOR_WEIGHT=0.5
HYBRID_SEARCH_BM25_WEIGHT=0.5
# PostgreSQL text search configuration used for stemming.
BM25_TEXT_CONFIG=english

# --- Agent behaviour -------------------------------------------------------
# Timeout for ONE model call, not for one agent request. An agent request is a
# loop and can legitimately take a multiple of this. An invalid value silently
# falls back to 150s, which is shorter than the documented default.
LOCALAGI_TIMEOUT=5m

# How long a previous_response_id keeps its conversation, in memory only.
# Expiry returns an EMPTY conversation rather than an error, so an idle agent
# appears to have forgotten everything with nothing logged above debug.
LOCALAGI_CONVERSATION_DURATION=1h

# Writes every turn to /pool/conversations as JSON. An audit log, not state —
# nothing reads it back.
LOCALAGI_ENABLE_CONVERSATIONS_LOGGING=false

# --- Authentication --------------------------------------------------------
# Off by default so the environment works out of the box. Each hop
# authenticates INDEPENDENTLY; setting one and assuming the rest follow
# produces 401s on internal hops while the external surface looks healthy.
#
# To enable, uncomment the matching lines in docker-compose.yml and set all of:
#
#   LOCALAI_API_KEY             inbound to LocalAI
#   LOCALAGI_LLM_API_KEY        outbound from LocalAGI  -> must equal LOCALAI_API_KEY
#   LOCALRECALL_OPENAI_API_KEY  outbound from LocalRecall -> must equal LOCALAI_API_KEY
#   LOCALAGI_API_KEYS           inbound to LocalAGI (comma-separated)
#   LOCALRECALL_API_KEYS        inbound to LocalRecall (comma-separated)
#
# Note: when LOCALAGI_LLM_API_KEY is unset the client sends the literal string
# "sk-xxx" rather than no credential at all.
#
# LOCALAI_API_KEY=
# LOCALAGI_LLM_API_KEY=
# LOCALRECALL_OPENAI_API_KEY=
# LOCALAGI_API_KEYS=
# LOCALRECALL_API_KEYS=

# --- Debugging -------------------------------------------------------------
# Set true when retrieval "does not work". The three guards that silently skip
# knowledge lookup log at DEBUG level only, and this is the only way to see them.
DEBUG=false
